# ==========================================
# Variaveis de ambiente do backend
# Copie este arquivo para .env e ajuste os valores.
# O .env e opcional: sem ele o servidor so usa as variaveis do ambiente.
# ==========================================

# Porta do servidor
PORT=3001

# ------------------------------------------
# Instagram
# URL base da API do Instagram (provedor InstagramProvider)
# ------------------------------------------
INSTAGRAM_API_URL=https://instagram-api-green.vercel.app

# ------------------------------------------
# Ferramentas externas (usadas por TikTok e YouTube)
# ------------------------------------------

# Caminho do executavel do yt-dlp.
# Se ficar vazio, o yt-dlp sera procurado no PATH do sistema.
# Windows: C:\caminho\yt-dlp.exe
# Linux/mac: /usr/local/bin/yt-dlp
YTDLP_PATH=

# Caminho do ffmpeg (opcional).
# O yt-dlp usa para mesclar video e audio quando a plataforma separa as faixas.
# Deve ser o executavel ffmpeg ou o diretorio que o contem.
# Windows: C:\caminho\ffmpeg\bin
# Linux/mac: /usr/bin
FFMPEG_PATH=

# Caminho do Deno (opcional).
# Habilitado como runtime JavaScript do yt-dlp, necessario em algumas
# extrações do YouTube que pedem solver de desafio JS.
# Windows: C:\caminho\deno.exe
# Linux/mac: /usr/local/bin/deno
DENO_PATH=

# Tempo limite da extracao em milissegundos (opcional, padrao 120000).
# A primeira extracao do YouTube pode demorar por causa do solver JS,
# entao o padrao e bem acima do tempo tipico de execucao.
YTDLP_TIMEOUT_MS=120000

# Argumentos extras do yt-dlp, separados por espaco (opcional).
# Exemplo: --cookies-from-browser chrome
# Vem do ambiente do servidor, nunca do usuario.
YTDLP_EXTRA_ARGS=